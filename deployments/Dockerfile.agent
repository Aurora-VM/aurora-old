# Build Stage
FROM golang:1.22-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=0.1.0
ARG COMMIT=dev
ARG BUILD_DATE=unknown

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s -X 'github.com/aurora-vm/aurora/pkg/version.Version=${VERSION}' -X 'github.com/aurora-vm/aurora/pkg/version.GitCommit=${COMMIT}' -X 'github.com/aurora-vm/aurora/pkg/version.BuildDate=${BUILD_DATE}'" \
    -o /bin/aurora-agent ./cmd/aurora-agent

# Final Runtime Image for Agent
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY --from=builder /bin/aurora-agent /usr/local/bin/aurora-agent

ENTRYPOINT ["/usr/local/bin/aurora-agent"]
